{
    "id": "/dashboard",
    "name": "VouchEx",
    "short_name": "VouchEx",
    "description": "VouchEx — practice dashboard for CA firms: clients, tasks, compliance and invoices.",
    "start_url": "/dashboard?source=app",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#0b1736",
    "theme_color": "#0b1736",
    "icons": [
        { "src": "/icons/vouchex-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icons/vouchex-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icons/vouchex-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Tasks", "url": "/tasks?source=app" },
        { "name": "Clients", "url": "/clients?source=app" },
        { "name": "Invoices", "url": "/invoices?source=app" }
    ]
}
