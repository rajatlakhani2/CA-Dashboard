{
  "appId": "in.org.kuhu.cadashboard",
  "appName": "CA Dashboard",
  "webDir": "www",
  "server": {
    "url": "https://app.kuhu.org.in/home",
    "androidScheme": "https",
    "errorPath": "error.html",
    "allowNavigation": [
      "app.kuhu.org.in"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0c1f4a",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0c1f4a",
      "overlaysWebView": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
